{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraView",
  "version": "0.3.8",
  "identifier": "com.auraview.browser",
  "build": {
    "beforeDevCommand": "npm run prepare:video-tools && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:video-tools && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraView",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/download-tools/": "download-tools/",
      "resources/adblock/": "adblock/",
      "icons/icon.ico": "auraview-purple-globe-2026.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi"
      },
      "wix": {
        "template": "windows/main.wxs"
      }
    }
  }
}
