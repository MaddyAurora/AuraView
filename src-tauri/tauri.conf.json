{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraView",
  "version": "0.1.3",
  "identifier": "com.auraview.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraView",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-web-security --disable-features=IsolateOrigins,site-per-process,msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
